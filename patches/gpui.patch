diff --git a/crates/gpui_linux/src/linux/x11/scroll.rs b/crates/gpui_linux/src/linux/x11/scroll.rs
new file mode 100644
index 0000000..688368f
--- /dev/null
+++ b/crates/gpui_linux/src/linux/x11/scroll.rs
@@ -0,0 +1,61 @@
+use gpui::{Modifiers, Pixels, Point, ScrollDelta, ScrollWheelEvent, point, px};
+
+pub(super) fn make_scroll_wheel_event(
+    position: Point<Pixels>,
+    scroll_delta: Point<f32>,
+    modifiers: Modifiers,
+    precise: bool,
+) -> ScrollWheelEvent {
+    let delta = if modifiers.shift {
+        point(scroll_delta.y, 0.0)
+    } else {
+        scroll_delta
+    };
+    let delta = if precise {
+        // XInput normalizes scroll valuators to lines; expose touchpad movement as logical pixels.
+        ScrollDelta::Pixels(point(px(delta.x * 32.0), px(delta.y * 32.0)))
+    } else {
+        ScrollDelta::Lines(delta)
+    };
+    ScrollWheelEvent {
+        position,
+        delta,
+        modifiers,
+        touch_phase: Default::default(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn trackpad_is_precise_and_mouse_wheel_remains_lines() {
+        for precise in [false, true] {
+            let event = make_scroll_wheel_event(
+                point(px(80.0), px(60.0)),
+                point(0.5, -0.25),
+                Modifiers::default(),
+                precise,
+            );
+            assert_eq!(event.delta.precise(), precise);
+            assert_eq!(event.delta.pixel_delta(px(32.0)), point(px(16.0), px(-8.0)));
+        }
+    }
+
+    #[test]
+    fn shift_preserves_horizontal_scroll_mapping() {
+        for precise in [false, true] {
+            let event = make_scroll_wheel_event(
+                Point::default(),
+                point(0.0, -0.25),
+                Modifiers {
+                    shift: true,
+                    ..Default::default()
+                },
+                precise,
+            );
+            assert_eq!(event.delta.pixel_delta(px(32.0)), point(px(-8.0), px(0.0)));
+        }
+    }
+}
